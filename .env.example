# Template for .env. Copy it to .env and fill in your keys.
# .env is ignored by Git. This file is not, so never put a real key here.

# The language model.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# The checker: a second model for the yes-or-no checks. See docs/designs/checker_model.md.
# CHECKER_ENABLED is the on/off switch, and `dental-agent chat --checker on|off` overrides it for
# one call. Backends are tried in order, and one without its key is left out.
CHECKER_ENABLED=true
CHECKER_BACKENDS=jev,anthropic
CHECKER_JEV_MODEL=typesafe/jev-1.14
CHECKER_ANTHROPIC_MODEL=claude-haiku-5-5
CHECKER_JEV_TIMEOUT_S=1.0
CHECKER_ANTHROPIC_TIMEOUT_S=2.0
CHECKER_CUTOFF=0.5

# Embeddings for hybrid search, used from Stage 5 with the embeddings extra.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Voice, used from Stage 2.
SPEECH_BACKEND=deepgram
DEEPGRAM_API_KEY=

# Where LangGraph keeps call state: memory, or sqlite with the checkpoint-sqlite extra.
CHECKPOINTER=memory
